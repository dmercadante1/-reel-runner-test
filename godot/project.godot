; Fresh production foundation; old Phaser releases are not imported.
config_version=5

[application]
config/name="MovieCameraPrototype"
run/main_scene="res://scenes/web_trial.tscn"
run/main_scene.courtyard="res://scenes/gothic_room.tscn"
run/main_scene.scroll="res://scenes/courtyard_stage.tscn"
run/main_scene.chapter="res://scenes/gothic_chapter.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Controls="*res://scripts/input_setup.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.065, 1)

[physics]
common/physics_ticks_per_second=60
